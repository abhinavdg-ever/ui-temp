# Data source mode: "local" | "postgres"
# local    → Manifest from METADATA_ROOT CSVs; OCR from local ocr/ files
# postgres → Manifest from manifest_member_list; OCR from ocr_results
DATA_MODE=local

# Local filesystem root containing document folders
DATA_ROOT=./data/folders

# Pipeline CSV drop folder — all imaging exports + Manifest metadata_R*_B*.csv
# Flat files or mirrored pack paths — see data/pipeline/README.md
PIPELINE_ROOT=./data/pipeline

# Manifest Details CSVs (metadata_R{n}_B{n}.csv). Prefer data/pipeline;
# falls back to sibling 06-postgres-db/manifest if not present there.
METADATA_ROOT=./data/pipeline

# Docker: host paths mounted into the backend (relative to 05-imaging-ui/)
# DATA_HOST_PATH=./data/folders
# METADATA_HOST_PATH=./data/pipeline
# PIPELINE_HOST_PATH=./data/pipeline

# Postgres (db-insert writes; DATA_MODE=postgres reads manifest + ocr_results)
# Database name = imaging_outputs; tables are in schema public (see DBeaver).
DATABASE_URL=postgresql+psycopg://aiuser:passwordpoc2026@172.20.4.170:5432/imaging_outputs
DB_SCHEMA=public

# API (local uvicorn defaults; Docker uses 3000 / 3001)
API_HOST=127.0.0.1
API_PORT=8002
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:3001,http://localhost:3001

# ---------------------------------------------------------------------------
# Azure Blob — File Viewer + chart_list container/path
# ---------------------------------------------------------------------------
FILE_VIEWER_BLOB_ENABLED=true
BLOB_AUTH_MODE=entra

# Bare account name or full https://….blob.core.windows.net URL
BLOB_ACCOUNT_URL=azsadve2aipoc
BLOB_CONTAINER=imaging-pipeline
# Prefix-only: folder name is appended → …/DEID_PNGs/<folder>
BLOB_PATH_TEMPLATE=Raw_Input/Run1/Batch1/DEID_PNGs/

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional Azure OpenAI for 02-imaging-pipeline/dos-extraction
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

