# Data source mode: "local" | "postgres"
DATA_MODE=local

# Local filesystem root containing document folders
# Expected layout per folder:
#   <DATA_ROOT>/<folder_name>/
#     pages/1.jpg …
#     ocr/<folder_name>_prelim.txt    # Preliminary (Tess) → ocr_type=tesseract
#     ocr/<folder_name>_final1.txt    # Final (OSS) → ocr_type=docling
#     ocr/<folder_name>_final2.json   # Final (AzDocInt) → ocr_type=azuredocintel (JSON OK in raw_text)
DATA_ROOT=./data/folders

# Docker: host path mounted into the backend container as /data/folders
# DATA_HOST_PATH=./data/folders

# Postgres mode (unused while DATA_MODE=local)
# READ:  manifest_member_list
# WRITE: chart_list (blob_container_name←BLOB_CONTAINER, path←BLOB_PATH_TEMPLATE/{folder}),
#        page_list, ocr_results
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/advantmed_imaging

# API (local uvicorn defaults; Docker uses 3000 / 3001)
API_HOST=127.0.0.1
API_PORT=8002
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:3001,http://localhost:3001

# ---------------------------------------------------------------------------
# Azure Blob — File Viewer + chart_list container/path
# ---------------------------------------------------------------------------
# Show Local | Blob toggle
FILE_VIEWER_BLOB_ENABLED=true

# entra = Entra ID / Managed Identity (works when Shared Key is disabled)
# sas   = legacy account/service SAS (blocked if AllowSharedKeyAccess=false)
BLOB_AUTH_MODE=entra

# e.g. https://mystorage.blob.core.windows.net
BLOB_ACCOUNT_URL=
# → chart_list.blob_container_name; also File Viewer container
BLOB_CONTAINER=
# Object key template. Tokens: {folder} {filename} {page}
# Folder name = chart_name; chart_list.path uses this template for the chart prefix
BLOB_PATH_TEMPLATE={folder}/pages/{filename}

# App registration (optional if the VM/container uses Managed Identity or `az login`)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Legacy only when BLOB_AUTH_MODE=sas
BLOB_SAS_TOKEN=
