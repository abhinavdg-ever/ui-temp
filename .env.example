# Client review UI settings. Copy to .env (never commit .env) and fill in.

# The client's database (plain postgresql:// or postgresql+psycopg://).
# From inside the container use the Postgres server's IP, not localhost.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/imaging_outputs_client
DB_POOL_MAX=10

# Ports on the VM, and the address the client's browser uses.
BACKEND_PORT=5000
FRONTEND_PORT=5001
ALLOWED_ORIGINS=http://172.20.4.170:5001,http://localhost:5001

# Sign-in. Our users are copied into the client database, so the same usernames and
# passwords work. A new secret here means a session from our UI does not open this one:
#   openssl rand -hex 32
AUTH_SECRET=
AUTH_SESSION_HOURS=12
# Optional local admin with no users row; both empty = none. Never a real password.
LOGIN_USERNAME=
LOGIN_PASSWORD=

# --- Azure Blob: page images. Copy these lines from our review-ui/.env. ---
AZURE_STORAGE_AUTH=managed_identity
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=imaging-pipeline
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Optional: the MiniLM folder for the accuracy report's semantic page-type match, e.g.
# /opt/advantmed/advantmed-imaging-pipeline/core-pipeline/models/semantic-model
# SEMANTIC_MODEL_HOST_PATH=
