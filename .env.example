# Client review UI settings. Copy to .env (never commit .env) and fill in.

# Postgres only. Docker sets this itself; keep it for a local run (without it a local
# run starts in Local mode and shows no charts).
DATA_MODE=production

# The client's database (plain postgresql:// or postgresql+psycopg://).
# From inside the container use the Postgres server's IP, not localhost.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/imaging_outputs_client
# 3 reviewers at once on the VM: 12 kept open, at most 16 (a chart open runs up to 4
# queries). A laptop run over VPN: DB_POOL_MIN=2.
DB_POOL_MIN=12
DB_POOL_MAX=16
# Seconds one new connection may take; raise it on a slow link.
DB_CONNECT_TIMEOUT_SEC=10

# Page Details shows only the Final values, headed Algorithm (Docker sets this itself;
# keep it for a local run).
CLIENT_VIEW=true

# Ports on the VM, and the address the client's browser uses.
BACKEND_PORT=5000
FRONTEND_PORT=5001
ALLOWED_ORIGINS=http://172.20.4.170:5001,http://localhost:5001

# Sign-in. AUTH_SECRET is not a password anyone types: it is a random key the API signs
# each sign-in with, so the browser's session can be checked. Make one, paste it here,
# never change it while people are working:
#   openssl rand -hex 32          (Windows PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))
# Empty = a new key at every start, so everyone has to sign in again after a restart.
# Our users are copied into the client database, so the same usernames and passwords work.
AUTH_SECRET=
AUTH_SESSION_HOURS=12
# Optional local admin with no users row; both empty = none. Never a real password.
LOGIN_USERNAME=
LOGIN_PASSWORD=

# --- Azure Blob: page images, signed in as core-pipeline does. ---
# On the VM: managed_identity, AZURE_CLIENT_ID = the VM's user-assigned identity (the
# same value as core-pipeline/.env), no secret. On a laptop: entra (uses az login).
AZURE_STORAGE_AUTH=managed_identity
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=imaging-pipeline
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Optional: the MiniLM folder for the accuracy report's semantic page-type match, e.g.
# /opt/advantmed/advantmed-imaging-pipeline/core-pipeline/models/semantic-model
# SEMANTIC_MODEL_HOST_PATH=
