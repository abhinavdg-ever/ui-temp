# Data source mode: "local" | "postgres"
# local    → Manifest from METADATA_ROOT CSVs; OCR from local ocr/ files
# postgres → Manifest from manifest_member_list; OCR from ocr_results
DATA_MODE=local

# Local filesystem root containing document folders
DATA_ROOT=./data/folders

# Stacked Metadata_R1_B1.csv / metadata_R*_B*.csv (DATA_MODE=local)
METADATA_ROOT=./postgres-db/metadata

# Docker: host path mounted into the backend container as /data/folders
# DATA_HOST_PATH=./data/folders

# Postgres (db-insert writes; DATA_MODE=postgres reads manifest + ocr_results)
DATABASE_URL=postgresql+psycopg://aiuser:passwordpoc2026@172.20.4.170/imaging_outputs

# API (local uvicorn defaults; Docker uses 3000 / 3001)
API_HOST=127.0.0.1
API_PORT=8002
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:3001,http://localhost:3001

# ---------------------------------------------------------------------------
# Azure Blob — File Viewer + chart_list container/path
# ---------------------------------------------------------------------------
FILE_VIEWER_BLOB_ENABLED=true
BLOB_AUTH_MODE=entra

# Bare account name or full https://….blob.core.windows.net URL
BLOB_ACCOUNT_URL=azsadve2aipoc
# → chart_list.blob_container_name; also File Viewer container
BLOB_CONTAINER=imaging-pipeline
# Prefix and/or tokens {folder} {filename} {page}
# Prefix-only example (folder name appended): Raw_Input/Run1/Batch1/DEID_PNGs/
BLOB_PATH_TEMPLATE=Raw_Input/Run1/Batch1/DEID_PNGs/

# App registration (optional if using Managed Identity / az login)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Legacy only when BLOB_AUTH_MODE=sas
BLOB_SAS_TOKEN=
