# review-ui settings (the client's copy). Copy to .env and fill in the blanks. Keep both files in the same order.
# review-ui reads only the database (results) and Azure Blob (page images).

# --- 1. DATABASE (the client's own; in Docker use the server's IP, not localhost) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/imaging_outputs_client
DB_SCHEMA=public
DB_POOL_MIN=12
DB_POOL_MAX=16
DB_POOL_WAIT_SEC=10
DB_CONNECT_TIMEOUT_SEC=10

# --- 2. AZURE BLOB (auth: managed_identity | entra | key | client_secret; same values as core-pipeline/.env) ---
AZURE_STORAGE_AUTH=managed_identity
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=imaging-pipeline
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# --- 3. PORTS (Docker host) AND CORS ---
BACKEND_PORT=5000
FRONTEND_PORT=5001
ALLOWED_ORIGINS=http://172.20.4.170:5001,http://localhost:5001
BACKEND_URL=http://backend:3000

# --- 4. SIGN-IN (AUTH_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"; empty = new each start) ---
AUTH_SECRET=
AUTH_SESSION_HOURS=12
LOGIN_USERNAME=
LOGIN_PASSWORD=

# --- 5. ACCURACY REPORT (MiniLM; empty = ../core-pipeline/models/semantic-model, Docker: /models/semantic-model) ---
SEMANTIC_MODEL_PATH=
SEMANTIC_MODEL_HOST_PATH=

# --- 6. PLAYGROUND (admins: "Label=URL" pairs, first = default; empty = off) ---
CORE_PIPELINE_URLS=
PLAYGROUND_CONTAINER=imaging-pipeline
ORCHESTRATOR_API_KEY=

# --- 7. VIEW (true only in the client's copy: Page Details shows Final alone, headed Algorithm) ---
CLIENT_VIEW=true

# --- 8. PLATFORM (DB_BACKEND: postgres | cosmos | both; only postgres is wired yet) ---
DB_BACKEND=postgres
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=imaging
